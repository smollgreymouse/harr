#!/usr/bin/env bash
# HARR_LEANCTX_WRAPPER=1
set -Eeuo pipefail

readonly HARR_LEANCTX_VERSION="3.9.15"
readonly REAL="${HARR_LEANCTX_REAL:-${HOME}/.local/libexec/harr/vendor/lean-ctx/${HARR_LEANCTX_VERSION}/lean-ctx}"
readonly MANAGER="${HARR_MCP_MANAGER:-${HOME}/.local/libexec/harr/common/mcp/manager.py}"
readonly RUNTIME_ENV="${HARR_RUNTIME_ENV:-${XDG_CONFIG_HOME:-${HOME}/.config}/harr/runtime.env}"
[[ -x "$REAL" ]] || { printf 'Harr LeanCTX binary is missing: %s\nRun: harr install leanctx\n' "$REAL" >&2; exit 127; }
[[ -r "$MANAGER" ]] || { printf 'Harr MCP manager is missing: %s\n' "$MANAGER" >&2; exit 127; }
if [[ -r "$RUNTIME_ENV" ]]; then
  # shellcheck disable=SC1090
  source "$RUNTIME_ENV"
fi
export HARR_NPM_BIN_DIR="${HARR_NPM_BIN_DIR:-${HOME}/.local/share/harr/npm/node_modules/.bin}"
base_path="${HOME}/.local/bin:${HARR_NPM_BIN_DIR}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
[[ -n "${HARR_NODE_BIN_DIR:-}" ]] && base_path="${HARR_NODE_BIN_DIR}:${base_path}"
[[ -n "${HARR_PYTHON_BIN:-}" ]] && base_path="$(dirname -- "$HARR_PYTHON_BIN"):${base_path}"
export PATH="${base_path}:${PATH:-}"
python_bin="${HARR_PYTHON_BIN:-$(command -v python3 || true)}"
[[ -n "$python_bin" && -x "$python_bin" ]] || { printf 'python3 is required by the Harr LeanCTX wrapper\n' >&2; exit 127; }
exec "$python_bin" "$MANAGER" exec-leanctx "$REAL" -- "$@"
