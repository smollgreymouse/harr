#!/usr/bin/env bash
set -Eeuo pipefail

readonly HARR_VERSION="1.0.0"
readonly SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -d "${SELF_DIR}/files/harr-cli" ]]; then
  readonly CLI_LIB_DIR="${SELF_DIR}/files/harr-cli"
  HARR_COMMON_DIR="$(cd -- "${SELF_DIR}/../common" && pwd)"
else
  readonly CLI_LIB_DIR="${HARR_LIBEXEC_DIR:-${HOME}/.local/libexec/harr/cli}"
  HARR_COMMON_DIR="${HARR_COMMON_DIR:-${HOME}/.local/libexec/harr/common}"
fi
export HARR_COMMON_DIR

source "${CLI_LIB_DIR}/common.sh"
source "${HARR_COMMON_DIR}/shell/selection.sh"
source "${CLI_LIB_DIR}/help.sh"
source "${HARR_COMMON_DIR}/shell/agents.sh"
source "${HARR_COMMON_DIR}/shell/hosts.sh"
source "${CLI_LIB_DIR}/components.sh"
source "${HARR_COMMON_DIR}/shell/secret.sh"
source "${HARR_COMMON_DIR}/shell/leanctx.sh"
source "${HARR_COMMON_DIR}/shell/git.sh"
source "${HARR_COMMON_DIR}/shell/kube.sh"
source "${CLI_LIB_DIR}/mcp.sh"
source "${CLI_LIB_DIR}/uninstall.sh"

command="${1:-help}"
shift || true

case "$command" in
  install)
    install_target="${1:-all}"
    cmd_install_components "$@"
    case "$install_target" in
      all|leanctx) cmd_hosts_apply; cmd_agents_apply all ;;
    esac
    ;;
  agents) cmd_agents "$@" ;;
  hosts) cmd_hosts "$@" ;;
  secret) cmd_secret "$@" ;;
  leanctx) cmd_leanctx "$@" ;;
  git) cmd_git "$@" ;;
  kube) cmd_kube "$@" ;;
  kubectl) cmd_kubectl "$@" ;;
  mcp) cmd_mcp "$@" ;;
  ein)
    if [[ "${1:-}" == apply ]]; then
      [[ $# -eq 1 ]] || die 'usage: harr ein apply'
      cmd_leanctx_apply
      cmd_agents_apply all
    else
      python3 "${HARR_COMMON_DIR}/mcp/ein_instances.py" "$@"
    fi
    ;;
  status) cmd_status "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  version|--version|-V) printf 'Harr %s\n' "$HARR_VERSION" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command (see harr help)" ;;
esac
