[Unit]
Description=Harr MCP - CodeGraph HTTP bridge

[Service]
Type=simple
EnvironmentFile=%h/.config/harr/runtime.env
EnvironmentFile=%h/.config/harr/mcp/codegraph.env
ExecStart=%h/.local/libexec/harr/mcp/codegraph-run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
