#!/usr/bin/env bash
set -Eeuo pipefail

# HARR_GIT_MCP_WRAPPER=1
readonly PREFIX="${HARR_GIT_MCP_PREFIX:-${HOME}/.local/share/harr/python/git-mcp}"

[[ -d "$PREFIX" ]] || {
  printf 'Error: Harr git MCP runtime not installed: %s\n' "$PREFIX" >&2
  exit 1
}
command -v git >/dev/null 2>&1 || {
  printf 'Error: git is required by Harr git MCP\n' >&2
  exit 1
}

repo_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'Error: Harr git MCP must be spawned from inside a Git repository; cwd=%s\n' "$PWD" >&2
  exit 1
}
cd "$repo_root"

export PYTHONPATH="${PREFIX}${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m mcp_server_git --repository "$repo_root" "$@"
