#!/usr/bin/env bash
set -Eeuo pipefail

: "${HARR_NODE_BIN_DIR:?HARR_NODE_BIN_DIR is not set}"
: "${HARR_NPM_BIN_DIR:?HARR_NPM_BIN_DIR is not set}"
: "${GITLAB_API_URL:?GITLAB_API_URL is not set}"

export PATH="${HARR_NODE_BIN_DIR}:${HARR_NPM_BIN_DIR}:${PATH:-/usr/local/bin:/usr/bin:/bin}"
export HOST="${HOST:-127.0.0.1}"
export PORT="${PORT:-3334}"
export STREAMABLE_HTTP="${STREAMABLE_HTTP:-true}"
export SSE="${SSE:-false}"
export REMOTE_AUTHORIZATION="${REMOTE_AUTHORIZATION:-true}"
export GITLAB_PERMISSION_MODE="${GITLAB_PERMISSION_MODE:-full}"
export GITLAB_TOOLSETS="${GITLAB_TOOLSETS:-all}"
export GITLAB_DISABLE_VERSION_CHECK="${GITLAB_DISABLE_VERSION_CHECK:-true}"
export NO_PROXY="${NO_PROXY:-127.0.0.1,localhost}"

launcher="${HARR_NPM_BIN_DIR}/zereight-mcp-gitlab"
[[ -x "$launcher" ]] || {
  printf 'GitLab MCP is not installed in Harr runtime: %s\n' "$launcher" >&2
  exit 127
}

exec "$launcher"
