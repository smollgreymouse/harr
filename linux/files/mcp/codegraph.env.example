# Harr-managed CodeGraph MCP bridge.
HARR_MCP_ENDPOINT=http://127.0.0.1:3333/mcp
HARR_CODEGRAPH_PORT=3333
HARR_SUPERGATEWAY_LOG_LEVEL=none
CODEGRAPH_NO_UPDATE_CHECK=1

# Optional fixed project root. Leave empty for a global service; in that mode
# CodeGraph calls should pass projectPath explicitly because LeanCTX's downstream
# MCP client does not forward the parent client's roots/list capability.
HARR_CODEGRAPH_PROJECT_ROOT=
