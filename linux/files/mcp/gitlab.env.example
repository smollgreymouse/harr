# Harr-managed GitLab MCP runtime. No PAT belongs here.
HARR_MCP_ENDPOINT=http://127.0.0.1:3334/mcp
HOST=127.0.0.1
PORT=3334
STREAMABLE_HTTP=true
SSE=false
REMOTE_AUTHORIZATION=true
