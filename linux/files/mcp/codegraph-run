#!/usr/bin/env bash
set -Eeuo pipefail

: "${HARR_NODE_BIN_DIR:?HARR_NODE_BIN_DIR is not set}"
: "${HARR_NPM_BIN_DIR:?HARR_NPM_BIN_DIR is not set}"

export PATH="${HARR_NODE_BIN_DIR}:${HARR_NPM_BIN_DIR}:${PATH:-/usr/local/bin:/usr/bin:/bin}"

bridge="${HARR_NPM_BIN_DIR}/supergateway"
stdio_server="${HOME}/.local/libexec/harr/mcp/codegraph-stdio"
[[ -x "$bridge" ]] || {
  printf 'Supergateway is not installed in Harr runtime: %s\n' "$bridge" >&2
  exit 127
}
[[ -x "$stdio_server" ]] || {
  printf 'CodeGraph stdio runner is missing: %s\n' "$stdio_server" >&2
  exit 127
}

exec "$bridge" \
  --stdio "$stdio_server" \
  --outputTransport streamableHttp \
  --stateful \
  --port "${HARR_CODEGRAPH_PORT:-3333}" \
  --streamableHttpPath /mcp \
  --logLevel "${HARR_SUPERGATEWAY_LOG_LEVEL:-none}"
