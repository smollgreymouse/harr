#!/usr/bin/env bash
# HARR_LEANCTX_WRAPPER=1
set -Eeuo pipefail

readonly HARR_LEANCTX_VERSION="3.9.15"
readonly REAL="${HARR_LEANCTX_REAL:-${HOME}/.local/libexec/harr/vendor/lean-ctx/${HARR_LEANCTX_VERSION}/lean-ctx}"
readonly SECRET_FILE="${HARR_GITLAB_SECRET_FILE:-${HOME}/.config/harr/secrets/gitlab-pat}"

[[ -x "$REAL" ]] || {
  printf 'Harr LeanCTX binary is missing: %s\nRun: harr install leanctx\n' "$REAL" >&2
  exit 127
}

# GUI/IDE launches often inherit a smaller PATH than an interactive shell.
# LeanCTX spawns CodeGraph by command name, so make Harr's user launchers
# resolvable without depending on shell startup files. Do not change cwd: the
# inherited project working directory is what makes CodeGraph project-aware.
export PATH="${HOME}/.local/bin:${PATH:-/usr/local/bin:/usr/bin:/bin}"

if [[ -r "$SECRET_FILE" ]]; then
  secret=''
  IFS= read -r secret <"$SECRET_FILE" || true
  if [[ -n "$secret" ]]; then
    export LEAN_CTX_SECRET_6D63702F6769746C61622F64656661756C74="$secret"
  fi
fi

exec "$REAL" "$@"
