#!/usr/bin/env bash
set -euo pipefail
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
BIN=${HARR_SCHEDULER_BIN:-${HARR_CODEX_SCHEDULER_BIN:-}}
if [[ -z "$BIN" ]]; then
  for candidate in "$DIR/../build/harr-scheduler" "$DIR/../harr-scheduler" \
                   "$DIR/../build/harr-codex-scheduler" "$DIR/../harr-codex-scheduler"; do
    if [[ -x "$candidate" ]]; then BIN="$candidate"; break; fi
  done
fi
if [[ -z "$BIN" ]]; then
  BIN=$(command -v harr-scheduler || command -v harr-codex-scheduler || true)
fi
if [[ -z "$BIN" || ! -x "$BIN" ]]; then
  echo 'harr-schedule: C++ scheduler binary not found' >&2
  exit 127
fi
exec "$BIN" schedule "$@"
