#!/usr/bin/env bash
set -euo pipefail
DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
if (($# < 3)); then
  echo 'Usage: luna AT_TIME SESSION_ID PROMPT' >&2
  exit 2
fi
when=$1; session=$2; shift 2
exec "$DIR/codex-schedule" --model gpt-5.6-luna --reasoning high --speed standard --at "$when" --session "$session" --prompt "$*"
