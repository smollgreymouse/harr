#!/usr/bin/env bash
set -euo pipefail

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
BIN=${HARR_CODEX_SCHEDULER_BIN:-}

if [[ -z "$BIN" && -x "$DIR/../build/harr-codex-scheduler" ]]; then
  BIN="$DIR/../build/harr-codex-scheduler"
fi
if [[ -z "$BIN" && -x "$DIR/../harr-codex-scheduler" ]]; then
  BIN="$DIR/../harr-codex-scheduler"
fi
if [[ -z "$BIN" ]]; then
  BIN=$(command -v harr-codex-scheduler || true)
fi
[[ -n "$BIN" && -x "$BIN" ]] || {
  echo 'codex-scheduler-ui: C++ scheduler binary not found; build with CMake first' >&2
  exit 127
}

exec "$BIN" "$@"
