{
  "schema": 1,
  "servers": [
    {
      "name": "codegraph",
      "label": "CodeGraph",
      "description": "cross-file code structure and impact analysis",
      "required": true,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@colbymchenry/codegraph",
        "version": "1.5.0",
        "command": "codegraph",
        "args": ["serve", "--mcp"]
      }
    },
    {
      "name": "gitlab",
      "label": "GitLab",
      "description": "GitLab API, merge requests, pipelines and issues",
      "required": false,
      "transport": "http",
      "lifecycle": "service",
      "url": "http://127.0.0.1:3334/mcp",
      "runtime": {
        "kind": "npm",
        "package": "@zereight/mcp-gitlab",
        "version": "2.1.48",
        "command": "zereight-mcp-gitlab",
        "args": []
      },
      "env_template": "gitlab.env.example",
      "skill_reference": "gitlab.md",
      "secrets": [
        {
          "name": "gitlab",
          "file": "gitlab-pat",
          "prompt": "GitLab PAT",
          "memento_id": "mcp/gitlab/default",
          "target": {"kind": "header", "name": "Private-Token"}
        }
      ],
      "windows_task": "Harr GitLab MCP"
    },
    {
      "name": "grafana",
      "label": "Grafana",
      "description": "Grafana dashboards and datasources",
      "required": false,
      "transport": "http",
      "lifecycle": "service",
      "url": "http://127.0.0.1:3335/mcp",
      "runtime": {
        "kind": "uvx",
        "package": "mcp-grafana",
        "command": "uvx",
        "args": ["mcp-grafana", "--transport", "streamable-http", "--address", "127.0.0.1:3335"],
        "prefetch_args": ["mcp-grafana", "--version"],
        "probe_args": ["--offline", "mcp-grafana", "--version"],
        "install_hint": "uvx is required for Grafana MCP; install uv/uvx and run `harr install mcp`"
      },
      "env_template": "grafana.env.example",
      "skill_reference": "grafana.md",
      "secrets": [
        {
          "name": "grafana",
          "file": "grafana-service-account-token",
          "prompt": "Grafana service account token",
          "memento_id": "mcp/grafana/default",
          "target": {"kind": "env", "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN"}
        }
      ]
    }
  ]
}
