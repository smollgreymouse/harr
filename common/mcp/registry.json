{
  "schema": 1,
  "servers": [
    {
      "name": "codegraph",
      "label": "CodeGraph",
      "description": "cross-file code structure and impact analysis",
      "required": true,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@colbymchenry/codegraph",
        "version": "1.5.0",
        "command": "codegraph",
        "args": [
          "serve",
          "--mcp"
        ]
      },
      "doctor": {
        "required_tools": [
          "codegraph_explore"
        ],
        "probe": {
          "kind": "catalog-only",
          "timeout_sec": 10
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    },
    {
      "name": "gitlab",
      "label": "GitLab",
      "description": "GitLab API, merge requests, pipelines and issues",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@zereight/mcp-gitlab",
        "version": "2.1.48",
        "command": "zereight-mcp-gitlab",
        "args": [],
        "env": {
          "STREAMABLE_HTTP": "false",
          "SSE": "false",
          "REMOTE_AUTHORIZATION": "false"
        }
      },
      "env_template": "gitlab.env.example",
      "skill_reference": "gitlab.md",
      "secrets": [
        {
          "name": "gitlab",
          "file": "gitlab-pat",
          "prompt": "GitLab PAT",
          "memento_id": "mcp/gitlab/default",
          "target": {
            "kind": "env",
            "name": "GITLAB_PERSONAL_ACCESS_TOKEN"
          }
        }
      ],
      "doctor": {
        "required_tools": [
          "health_check",
          "get_merge_request"
        ],
        "probe": {
          "kind": "tool",
          "tool": "health_check",
          "arguments": {},
          "timeout_sec": 10,
          "success": {
            "json_content": {
              "status": "ok",
              "authenticated": true
            }
          }
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    },
    {
      "name": "grafana",
      "label": "Grafana",
      "description": "Grafana dashboards and datasources",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "mcp-grafana",
        "command": "uvx",
        "args": [
          "--offline",
          "mcp-grafana",
          "--transport",
          "stdio"
        ],
        "prefetch_args": [
          "mcp-grafana",
          "--version"
        ],
        "probe_args": [
          "--offline",
          "mcp-grafana",
          "--version"
        ],
        "install_hint": "uvx is required for Grafana MCP; install uv/uvx and run `harr install mcp`"
      },
      "env_template": "grafana.env.example",
      "skill_reference": "grafana.md",
      "secrets": [
        {
          "name": "grafana",
          "file": "grafana-service-account-token",
          "prompt": "Grafana service account token",
          "memento_id": "mcp/grafana/default",
          "target": {
            "kind": "env",
            "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN"
          }
        }
      ],
      "doctor": {
        "required_tools": [
          "user_info"
        ],
        "probe": {
          "kind": "tool",
          "tool": "user_info",
          "arguments": {},
          "timeout_sec": 10,
          "success": {}
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    },
    {
      "name": "kibana",
      "label": "Kibana",
      "description": "read-only Kibana/Elasticsearch logs, mappings and search",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "git+https://github.com/smollgreymouse/kibana-agent.git@73cb2aa03462c44616601d5299515ff45ed36d7f",
        "version": "0.7.7 fork 73cb2aa",
        "command": "uvx",
        "args": [
          "--offline",
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@73cb2aa03462c44616601d5299515ff45ed36d7f",
          "kibana-agent",
          "mcp"
        ],
        "prefetch_args": [
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@73cb2aa03462c44616601d5299515ff45ed36d7f",
          "kibana-agent",
          "--version"
        ],
        "probe_args": [
          "--offline",
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@73cb2aa03462c44616601d5299515ff45ed36d7f",
          "kibana-agent",
          "--version"
        ],
        "install_hint": "uvx is required for Kibana MCP; install uv/uvx and run harr install mcp"
      },
      "env_template": "kibana.env.example",
      "skill_reference": "kibana.md",
      "secrets": [
        {
          "name": "kibana",
          "file": "kibana-api-key",
          "prompt": "Kibana API key",
          "memento_id": "mcp/kibana/default",
          "target": {
            "kind": "env",
            "name": "KIBANA_API_KEY"
          }
        }
      ],
      "doctor": {
        "required_tools": [
          "list_data_views"
        ],
        "probe": {
          "kind": "tool",
          "tool": "list_data_views",
          "arguments": {},
          "timeout_sec": 12,
          "success": {}
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    },
    {
      "name": "jira",
      "label": "Jira",
      "description": "Jira Server/Data Center issues and JQL via local REST MCP",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "mcp-atlassian",
        "command": "uvx",
        "args": [
          "mcp-atlassian"
        ],
        "prefetch_args": [
          "mcp-atlassian",
          "--help"
        ],
        "probe_args": [
          "--offline",
          "mcp-atlassian",
          "--help"
        ],
        "install_hint": "uvx is required for Jira MCP; install uv/uvx and run harr install mcp"
      },
      "env_template": "jira.env.example",
      "skill_reference": "jira.md",
      "secrets": [
        {
          "name": "jira-pat",
          "file": "jira-personal-token",
          "prompt": "Jira personal access token",
          "memento_id": "mcp/jira/default",
          "target": {
            "kind": "env",
            "name": "JIRA_PERSONAL_TOKEN"
          }
        },
        {
          "name": "jira",
          "file": "jira-user-password",
          "prompt": "Jira Basic password (corporate gateway)",
          "memento_id": "mcp/jira/basic-password",
          "target": {
            "kind": "env",
            "name": "JIRA_USER_PASS"
          }
        }
      ],
      "trust_store": "system",
      "doctor": {
        "required_tools": [
          "jira_get_all_projects"
        ],
        "probe": {
          "kind": "tool",
          "tool": "jira_get_all_projects",
          "arguments": {},
          "timeout_sec": 15,
          "success": {}
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    },
    {
      "name": "redash",
      "label": "Redash",
      "description": "metadata-only Redash queries, dashboards and schemas (no SQL execution or writes)",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@suthio/redash-mcp",
        "version": "0.1.1",
        "command": "redash-mcp",
        "args": [],
        "readonly_proxy": "redash_readonly_proxy.py",
        "env": {
          "MCP_TRANSPORT": "stdio",
          "OTEL_SDK_DISABLED": "true"
        }
      },
      "env_template": "redash.env.example",
      "skill_reference": "redash.md",
      "secrets": [
        {
          "name": "redash",
          "file": "redash-api-key",
          "prompt": "Redash API key",
          "memento_id": "mcp/redash/default",
          "target": {
            "kind": "env",
            "name": "REDASH_API_KEY"
          }
        }
      ],
      "doctor": {
        "required_tools": [
          "get_query"
        ],
        "probe": {
          "kind": "catalog-only",
          "timeout_sec": 10
        },
        "repair": {
          "runtime_reinstall": true,
          "credential_auto_repair": false
        }
      }
    }
  ]
}
