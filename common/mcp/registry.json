{
  "schema": 1,
  "servers": [
    {
      "name": "codegraph",
      "label": "CodeGraph",
      "description": "cross-file code structure and impact analysis",
      "required": true,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@colbymchenry/codegraph",
        "version": "1.5.0",
        "command": "codegraph",
        "args": [
          "serve",
          "--mcp"
        ]
      }
    },
    {
      "name": "gitlab",
      "label": "GitLab",
      "description": "GitLab API, merge requests, pipelines and issues",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "npm",
        "package": "@zereight/mcp-gitlab",
        "version": "2.1.48",
        "command": "zereight-mcp-gitlab",
        "args": [],
        "env": {
          "STREAMABLE_HTTP": "false",
          "SSE": "false",
          "REMOTE_AUTHORIZATION": "false"
        }
      },
      "env_template": "gitlab.env.example",
      "skill_reference": "gitlab.md",
      "secrets": [
        {
          "name": "gitlab",
          "file": "gitlab-pat",
          "prompt": "GitLab PAT",
          "memento_id": "mcp/gitlab/default",
          "target": {
            "kind": "env",
            "name": "GITLAB_PERSONAL_ACCESS_TOKEN"
          }
        }
      ]
    },
    {
      "name": "grafana",
      "label": "Grafana",
      "description": "Grafana dashboards and datasources",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "mcp-grafana",
        "command": "uvx",
        "args": [
          "--offline",
          "mcp-grafana",
          "--transport",
          "stdio"
        ],
        "prefetch_args": [
          "mcp-grafana",
          "--version"
        ],
        "probe_args": [
          "--offline",
          "mcp-grafana",
          "--version"
        ],
        "install_hint": "uvx is required for Grafana MCP; install uv/uvx and run `harr install mcp`"
      },
      "env_template": "grafana.env.example",
      "skill_reference": "grafana.md",
      "secrets": [
        {
          "name": "grafana",
          "file": "grafana-service-account-token",
          "prompt": "Grafana service account token",
          "memento_id": "mcp/grafana/default",
          "target": {
            "kind": "env",
            "name": "GRAFANA_SERVICE_ACCOUNT_TOKEN"
          }
        }
      ]
    },
    {
      "name": "kibana",
      "label": "Kibana",
      "description": "read-only Kibana/Elasticsearch logs, mappings and search",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "git+https://github.com/smollgreymouse/kibana-agent.git@7d36423cd67b30521dfdef0dbfc6ea980aee51f6",
        "version": "0.7.5 fork 7d36423",
        "command": "uvx",
        "args": [
          "--offline",
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@7d36423cd67b30521dfdef0dbfc6ea980aee51f6",
          "kibana-agent",
          "mcp"
        ],
        "prefetch_args": [
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@7d36423cd67b30521dfdef0dbfc6ea980aee51f6",
          "kibana-agent",
          "--version"
        ],
        "probe_args": [
          "--offline",
          "--from",
          "git+https://github.com/smollgreymouse/kibana-agent.git@7d36423cd67b30521dfdef0dbfc6ea980aee51f6",
          "kibana-agent",
          "--version"
        ],
        "install_hint": "uvx is required for Kibana MCP; install uv/uvx and run harr install mcp"
      },
      "env_template": "kibana.env.example",
      "skill_reference": "kibana.md",
      "secrets": [
        {
          "name": "kibana",
          "file": "kibana-api-key",
          "prompt": "Kibana API key",
          "memento_id": "mcp/kibana/default",
          "target": {
            "kind": "env",
            "name": "KIBANA_API_KEY"
          }
        }
      ]
    },
    {
      "name": "gigacode",
      "label": "GigaCode",
      "description": "persistent external executor for planner-to-builder delegation",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "bundled-python",
        "version": "1.11.0",
        "script": "gigacode_server.py",
        "requires_command": "gigacode",
        "args": [],
        "install_hint": "GigaCode CLI is required for the optional GigaCode executor MCP; install/configure `gigacode` and ensure it is in PATH"
      },
      "skill_reference": "gigacode.md"
    },
    {
      "name": "jira",
      "label": "Jira",
      "description": "Jira Server/Data Center issues and JQL via local REST MCP",
      "required": false,
      "transport": "stdio",
      "lifecycle": "on-demand",
      "runtime": {
        "kind": "uvx",
        "package": "mcp-atlassian",
        "command": "uvx",
        "args": [
          "mcp-atlassian"
        ],
        "prefetch_args": [
          "mcp-atlassian",
          "--help"
        ],
        "probe_args": [
          "--offline",
          "mcp-atlassian",
          "--help"
        ],
        "install_hint": "uvx is required for Jira MCP; install uv/uvx and run harr install mcp"
      },
      "env_template": "jira.env.example",
      "skill_reference": "jira.md",
      "secrets": [
        {
          "name": "jira",
          "file": "jira-personal-token",
          "prompt": "Jira Server/Data Center personal access token",
          "memento_id": "mcp/jira/default",
          "target": {
            "kind": "env",
            "name": "JIRA_PERSONAL_TOKEN"
          }
        }
      ]
    }
  ]
}
