# Elasticsearch endpoint reachable from the MCP Docker container.
# Store the API key separately with: harr secret set elasticsearch
# Note: localhost here means the container itself; use a routable cluster hostname/address.
ES_URL=https://elasticsearch.example.com:9200

# Development only. Uncomment only for a cluster with an intentionally untrusted TLS certificate.
# ES_SSL_SKIP_VERIFY=true
