# Elasticsearch endpoint. Store the API key separately with:
#   harr secret set elasticsearch
ES_URL=https://elasticsearch.example.com:9200

# The official npm server defaults to Elasticsearch 9.x behavior.
# Harr targets Elasticsearch 8.x here (including 8.19.x).
ES_VERSION=8

# Keep OpenTelemetry noise out of the MCP stdio channel.
OTEL_LOG_LEVEL=none

# Development only. Uncomment only for an intentionally untrusted TLS certificate.
# ES_SSL_SKIP_VERIFY=true
