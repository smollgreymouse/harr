# Configure HTTPS URL and auth mode. Never store passwords here.
JIRA_URL=https://jira.company.example
JIRA_AUTH_MODE=pat
# Basic mode: set JIRA_AUTH_MODE=basic and JIRA_USER_NAME; store password via harr secret set jira-password
# JIRA_USER_NAME=username
# JIRA_HOST=jira.company.example  # only same hostname as URL is supported
