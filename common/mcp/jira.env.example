# Jira REST endpoint and authentication mode. Keep credentials in Harr secrets.
JIRA_URL=https://jira.company.example
JIRA_AUTH_MODE=pat
# Basic mode:
# JIRA_AUTH_MODE=basic
# JIRA_USER_NAME=username
# Optional mTLS identity from the user's NSS database:
# JIRA_CLIENT_CERT_NSS=certificate-nickname
# Optional NSS database override (default: ~/.pki/nssdb):
# JIRA_CLIENT_CERT_NSS_DB=~/.pki/nssdb
# JIRA_HOST=jira.company.example  # only same hostname as URL is supported
