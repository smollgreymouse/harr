# Kibana base URLs. The first URL is the default endpoint.
# Separate multiple trusted endpoints with commas or whitespace.
# Store API key(s) with: harr secret set kibana
KIBANA_URL=https://kibana.example.com

# Multiple endpoints example:
# KIBANA_URL=https://kibana.example.com,https://kibana-staging.example.com
#
# KIBANA_API_KEY is injected from Harr secret storage, never kept in this file.
# One stored key is shared by all URLs. To use different keys, store one
# comma-separated key per KIBANA_URL, in the same order.

# Optional defaults:
# KIBANA_SPACE=default
# KIBANA_INDEX=logs-*
