# Kibana base URL. Store the API key with: harr secret set kibana
KIBANA_URL=https://kibana.example.com

# Optional trusted alternate endpoints that an MCP tool may select per call
# with kibana_url=. Comma- or whitespace-separated. Unlisted URLs are rejected.
# KIBANA_MCP_ALLOWED_URLS=https://kibana-staging.example.com,https://kibana-dr.example.com

# Optional defaults:
# KIBANA_SPACE=default
# KIBANA_INDEX=logs-*
