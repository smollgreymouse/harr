# Harr host adapter: Codex exposes the LeanCTX tool names directly.
CTX_READ=ctx_read
CTX_SHELL=ctx_shell
CTX_SEARCH=ctx_search
CTX_GLOB=ctx_glob
CTX_TOOLS=ctx_tools
CTX_CALL=ctx_call
HOST_NATIVE_POLICY='Prefer LeanCTX for workspace investigation. Native file read/search/glob may be used only when the target is outside LeanCTX addressable paths or LeanCTX is unavailable; keep those fallbacks narrow and bounded. Native shell is not a search/read fallback: do not emulate ctx_search/ctx_glob/ctx_read with rg/grep/find/sed/awk/cat/head/tail. Use native shell only for genuine CLI operations when the Harr routing above permits them.'
