# Harr host adapter: OpenCode is native-first (like ZCode). The LeanCTX MCP stays
# registered for CodeGraph, the service MCPs and named Ein; CTX_* entries name the
# primary tool for each shared routing rule, not necessarily a LeanCTX tool id.
CTX_READ='native read'
CTX_SHELL='native bash'
CTX_SEARCH='native grep'
CTX_GLOB='native glob'
CTX_TOOLS='lean-ctx_ctx_tools'
CTX_CALL='lean-ctx_ctx_call'
HOST_ORCHESTRATION_POLICY=''
HOST_NATIVE_POLICY='OpenCode native-first routing: all workspace file reads, searches, globs, and shell work use the native OpenCode tools (read/grep/glob/bash and the native editor). Never call lean-ctx_ctx_read, lean-ctx_ctx_search, lean-ctx_ctx_glob, lean-ctx_ctx_shell, or lean-ctx_ctx_call; the only Harr MCP calls are lean-ctx_ctx_tools for CodeGraph and the enabled service MCPs (and named Ein executors when configured).'
